# Copy this file to .env.local and fill in your real keys.
# .env.local is already gitignored — never commit real keys.

# Get this from console.anthropic.com -> API Keys
# You mentioned you don't have this yet.
ANTHROPIC_API_KEY=your_anthropic_key_here

# Get this from elevenlabs.io -> profile icon -> API Keys
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# From your cloned voice's settings page in ElevenLabs
ELEVENLABS_VOICE_ID=your_voice_id_here
